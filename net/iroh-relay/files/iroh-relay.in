#!/bin/sh

# PROVIDE: iroh-relay
# REQUIRE: DAEMON LOGIN
# KEYWORD: shutdown
#
. /etc/rc.subr

name=iroh_relay

load_rc_config $name

: ${iroh_relay_enable:=NO}
: ${iroh_relay_user:="iroh"}
: ${iroh_relay_group:="iroh"}

command="/usr/bin/true"
procname="/usr/sbin/daemon"
pidfile="/var/run/${name}.pid"
start_cmd=iroh_relay_start

iroh_relay_start()
{
	/usr/sbin/daemon -P ${pidfile} -r -f -u ${_user} -H %%PREFIX%%/bin/iroh-relay "${iroh_relay_flags}"

	if is_process_running; then
		echo "Started iroh-relay (pid=$(cat ${pidfile}))"
	else
		echo "Failed to start iroh-relay"
	fi
}

run_rc_command "$1"
